# Shared secret the phone app, CarPlay app and dashboard must present. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BRIDGE_TOKEN=change-me
PORT=8787

# --- Tesla Fleet API (optional) ---
# Register an app at https://developer.tesla.com, do the OAuth flow with the
# vehicle_cmds scope, and paste the tokens here. The refresh token keeps it working.
TESLA_VIN=
TESLA_CLIENT_ID=
TESLA_REFRESH_TOKEN=
TESLA_ACCESS_TOKEN=
# Most 2021+ cars need signed commands: run tesla-http-proxy and point this at it.
# TESLA_API_BASE=https://localhost:4443
# Other regions: https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_LOCALE=en-US

# off | accepted  (accepted = send pickup when you accept, drop-off when the trip starts)
AUTO_NAVIGATE=accepted

# Ride scoring thresholds (advisory only)
MIN_FARE=0
MIN_PER_MILE=1.00
MIN_PER_HOUR=25
MAX_PICKUP_MIN=12
MIN_RIDER_RATING=4.7
